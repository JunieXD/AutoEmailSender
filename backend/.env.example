# 默认不需要改，后端会自动使用项目根目录下的 data/auto_email_sender.db
DATABASE_URL=sqlite+aiosqlite:///D:/path/to/AutoEmailSender/data/auto_email_sender.db

# SQLite 大数据量运行参数（默认值已适合大多数桌面设备）
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_ENABLE_WAL=true
SQLITE_ENABLE_FOREIGN_KEYS=true
SQLITE_SYNCHRONOUS=NORMAL
SQLITE_CACHE_SIZE_MIB=64
SQLITE_MMAP_SIZE_MIB=256
SQLITE_WAL_AUTOCHECKPOINT_PAGES=1000
SQLITE_JOURNAL_SIZE_LIMIT_MIB=64
SQLITE_SLOW_QUERY_MS=250
SQLITE_MAINTENANCE_INTERVAL_SECONDS=21600
SQLITE_INCREMENTAL_VACUUM_PAGES=2000

# 本地后台 worker 轮询周期
DRAFT_WORKER_INTERVAL_SECONDS=10
DISPATCHER_INTERVAL_SECONDS=30
IMAP_POLL_INTERVAL_SECONDS=60
IMAP_IDENTITY_CONCURRENCY=3
IMAP_IDENTITY_SYNC_TIMEOUT_SECONDS=180
IMAP_IDENTITY_LEASE_SECONDS=60
IMAP_HISTORY_BATCH_SIZE=200
IMAP_HISTORY_COMMAND_BUDGET_PER_MINUTE=120
IMAP_HISTORY_COMMAND_RATE_PER_MINUTE=40
IMAP_HISTORY_COMMAND_BURST=3
IMAP_HISTORY_QUEUE_SETTLE_SECONDS=10
IMAP_HISTORY_BULK_HEADER_LIMIT=5000
IMAP_FETCH_BATCH_SIZE=20
IMAP_SENT_FOLDER_FAILURE_TTL_SECONDS=3600
IMAP_THROTTLE_BACKOFF_SECONDS=86400
IMAP_ENSURE_STATE_TTL_SECONDS=300
MATCH_ANALYSIS_JOB_WORKER_COUNT=1
MATCH_ANALYSIS_JOB_INTERVAL_SECONDS=10
MATCH_ANALYSIS_JOB_ITEM_CONCURRENCY=3

# 真实外部服务超时与回信回溯窗口
LLM_REQUEST_TIMEOUT_SECONDS=90
SMTP_SEND_TIMEOUT_SECONDS=30
IMAP_LOOKBACK_HOURS=72

# 测试环境可以关闭后台 worker，避免自动消费
ENABLE_BACKGROUND_WORKERS=true

# 爬虫调试日志开关；默认开启，会把 Agent 原始流式事件完整写入 JSONL 文件
CRAWLER_DEBUG=true

# 爬虫调试日志目录；未配置时默认写入 data/logs/crawler
CRAWLER_DEBUG_DIR=D:/path/to/AutoEmailSender/data/logs/crawler
