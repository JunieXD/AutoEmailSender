{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Auto Email Sender",
  "identifier": "io.github.juniexd.autoemailsender",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../ui/dist",
    "beforeDevCommand": "pnpm --dir ui dev",
    "beforeBuildCommand": "pnpm --dir ui build"
  },
  "app": {
    "windows": [
      {
        "title": "Auto Email Sender",
        "visible": false,
        "center": true,
        "preventOverflow": true,
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDRjdFNkMzMjZDRTMzNDUKUldSRk04NG13K2IzckxBMjZsZXZMNzkySGxUUHlYOEE2NzFsbkxUbm9zRXErMTROS3g2TGkxT1UK",
      "endpoints": [
        "https://github.com/JunieXD/AutoEmailSender/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
