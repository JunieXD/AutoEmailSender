{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Auto Email Sender",
  "identifier": "io.github.juniexd.autoemailsender",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../ui/dist",
    "beforeDevCommand": "pnpm --dir ui dev",
    "beforeBuildCommand": "pnpm --dir ui build"
  },
  "app": {
    "windows": [
      {
        "title": "Auto Email Sender",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
