{
  "db_name": "SQLite",
  "query": "SELECT m.from_name, m.from_address, m.subject, m.sent_at, m.body_text,\n            m.refs, m.message_id, (\n            SELECT address\n            FROM mentor_email\n            WHERE mentor_id = t.id\n            ORDER BY position\n            LIMIT 1\n        ) AS address\n        FROM mentor t\n        JOIN message_mentor mm ON mm.mentor_id = t.id\n        JOIN message m ON m.id = mm.message_id\n        WHERE t.id = ?1 AND m.message_id = ?2 AND m.kind = 'reply'",
